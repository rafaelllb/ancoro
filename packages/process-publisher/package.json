{
  "name": "@ancoro/process-publisher",
  "version": "0.1.0",
  "description": "Publica processos como portal web estático (determinístico, abre por file://). Não depende do Ancoro.",
  "author": "Rafael Brito",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build:viewer": "node build-viewer.mjs",
    "test": "node build-viewer.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "publish:portal": "tsx src/cli.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
