# =================================================
# Ancoro Backend - Configuração de Ambiente
# =================================================
# Copie este arquivo para .env.{ambiente} e ajuste os valores
# Ambientes suportados: demo, development, staging, production

# Ambiente atual
NODE_ENV=development

# Porta do servidor
PORT=3000

# =================================================
# DATABASE
# =================================================
# SQLite (dev/demo): file:./dev.db ou file:./demo.db
# PostgreSQL (staging/prod): postgresql://user:password@host:5432/database
DATABASE_URL="file:./dev.db"

# =================================================
# AUTENTICAÇÃO
# =================================================
# JWT Secret - MÍNIMO 32 caracteres em produção!
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="7d"

# =================================================
# MODO DEMO
# =================================================
# DEMO_MODE=true ativa modo demonstração independente de NODE_ENV
DEMO_MODE=false
# DEMO_AUTO_SEED=true popula banco automaticamente no startup
DEMO_AUTO_SEED=false

# =================================================
# LOGGING
# =================================================
# Níveis: debug, info, warn, error
LOG_LEVEL=info

# =================================================
# CORS
# =================================================
# Em produção, especifique o domínio exato: https://app.Ancoro.com
CORS_ORIGIN="*"

# =================================================
# PROCESS STUDIO (assinatura)
# =================================================
# Contratação única: liga/desliga o módulo inteiro (rotas, menu, aba do requisito).
# Ausente: ligado em dev/demo/test e DESLIGADO em production (fail-closed).
# No on-premise também exige licença válida.
# PROCESS_STUDIO_ENABLED=true

# ===== Leads comerciais (POST /api/leads, página /planos) =====
# [2026-10-24] Todos opcionais: o lead é sempre gravado no banco; sem canal configurado, só há log de aviso.
# Destinatário(s) do aviso, separados por vírgula
LEADS_NOTIFY_TO=
# SMTP para o aviso por e-mail (porta 587 = STARTTLS; 465 => SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
# Webhook Slack/Teams/Discord (payload { text })
LEADS_WEBHOOK_URL=
