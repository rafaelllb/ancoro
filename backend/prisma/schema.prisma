// Prisma Schema para Ancoro Application
// Database: PostgreSQL (staging e produÃ§Ã£o)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTA: SQLite não suporta enums nativamente.
// Usamos String com valores constantes.
// Em PostgreSQL, trocar String para enum nativo.

// ===== MODELS =====

model Project {
  id          String   @id @default(cuid())
  name        String
  client      String
  startDate   DateTime
  status      String   @default("DISCOVERY") // DISCOVERY | REALIZATION | GOLIVE | HYPERCARE | CLOSED

  // Padrão de ID de requisitos (flexível por projeto)
  // Formato: {prefix}{separator}{número com zero-padding}
  // Exemplo: REQ-001, US-0001, PROJ1_001
  reqIdPrefix     String   @default("REQ")   // Prefixo: 1-10 chars alfanumérico
  reqIdSeparator  String   @default("-")     // Separador: "-", "_", ou ""
  reqIdDigitCount Int      @default(3)       // Dígitos com zero-padding: 2-6

  requirements Requirement[]
  users        ProjectUser[]
  crossMatrix  CrossMatrixEntry[]
  sprints      Sprint[]
  listItems    ProjectListItem[]
  objectives   ProjectObjective[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String   // Hashed with bcrypt
  role        String   @default("CONSULTANT") // CONSULTANT | CLIENT | MANAGER | ADMIN

  projects    ProjectUser[]
  assignedRequirements Requirement[] @relation("ResponsibleConsultant")
  comments    Comment[]
  changes     ChangeLog[]
  ownedIntegrations CrossMatrixEntry[] @relation("IntegrationOwner")
  createdEvidences Evidence[] @relation("EvidenceCreator")
  verifiedEvidences Evidence[] @relation("EvidenceVerifier")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model ProjectUser {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  module      String?  // ISU | CRM | FICA | DEVICE | SD | MM | PM | OTHER (null para clientes/managers)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_users")
}

model Requirement {
  id              String   @id @default(cuid())
  reqId           String   // REQ-001, REQ-002 (human-readable)
  projectId       String

  // 5W2H Fields
  shortDesc       String   // <50 chars
  module          String   // ISU | CRM | FICA | DEVICE | SD | MM | PM | OTHER
  what            String   // O que precisa ser feito
  why             String   // Dor/objetivo de negócio
  who             String   // Quem executa
  when            String   // Frequência/trigger
  where           String   // Sistema atual → futuro
  howToday        String   // Processo atual - DEPRECATED: usar howAsIs/howToBe
  howMuch         String   // Volume/esforço - critério de aceitação prometido

  // HOW separado: AS IS e TO BE (Ancora Method v2)
  howAsIs         String?  // Processo atual (como funciona hoje)
  howToBe         String?  // Processo futuro (como deveria funcionar)

  // HOW MUCH separado: prometido vs realizado (Ancora Method v2)
  howMuchPromised String?  // Volumetria/critério de aceitação prometido
  howMuchActual   String?  // Volumetria/critério de aceitação realizado

  // Integrations (arrays de Req IDs)
  dependsOn       String   @default("") // JSON array string: ["REQ-002", "REQ-003"]
  providesFor     String   @default("") // JSON array string: ["REQ-005"]

  // Collaboration
  responsibleConsultantId String?
  responsibleBusiness String?
  consultantNotes String?  // Dúvidas do consultor
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | VALIDATED | CONFLICT | REJECTED | APPROVED
  observations    String?

  // ReqOps Validation Flags
  isOrphan        Boolean  @default(false)  // WHY não corresponde a nenhum objetivo cadastrado
  linkedObjectiveId String?  // Objetivo de projeto vinculado (opcional, para rastreabilidade)

  // Relations
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsibleConsultant User? @relation("ResponsibleConsultant", fields: [responsibleConsultantId], references: [id])
  comments        Comment[]
  changes         ChangeLog[]
  crossMatrixFrom CrossMatrixEntry[] @relation("FromRequirement")
  crossMatrixTo   CrossMatrixEntry[] @relation("ToRequirement")
  evidences       Evidence[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, reqId])
  @@map("requirements")
}

model Comment {
  id              String   @id @default(cuid())
  requirementId   String
  userId          String
  content         String
  type            String   @default("OBSERVATION") // QUESTION | ANSWER | OBSERVATION | CONFLICT

  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())

  @@map("comments")
}

// Evidências de implementação (Ancora Method v2)
// Requisito só pode ir para APPROVED com pelo menos uma evidência anexada
model Evidence {
  id              String   @id @default(cuid())
  requirementId   String
  userId          String   // Quem anexou a evidência

  // Tipo de evidência
  // COMMIT | TEST_RESULT | SCREENSHOT | APPROVAL_DOC | LINK | FILE | OTHER
  type            String

  // Título descritivo (ex: "Teste de integração OK", "Commit feature X")
  title           String

  // Descrição opcional com detalhes
  description     String?

  // URL ou referência externa (ex: link do commit, URL do Jira, etc)
  url             String?

  // Nome do arquivo se for upload (screenshot, documento)
  fileName        String?

  // Caminho do arquivo no storage (se aplicável)
  filePath        String?

  // Referência interna (ex: número do teste, ID do commit)
  reference       String?

  // Se a evidência foi verificada/aprovada por outro usuário
  verified        Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?

  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user            User     @relation("EvidenceCreator", fields: [userId], references: [id])
  verifier        User?    @relation("EvidenceVerifier", fields: [verifiedBy], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requirementId])
  @@map("evidences")
}

model CrossMatrixEntry {
  id              String   @id @default(cuid())
  projectId       String
  fromReqId       String   // ID interno do Requirement (não o reqId human-readable)
  toReqId         String   // ID interno do Requirement

  // Auto-generated fields (extraídos dos requisitos)
  fromModule      String   // ISU | CRM | FICA | DEVICE | SD | MM | PM | OTHER
  toModule        String   // ISU | CRM | FICA | DEVICE | SD | MM | PM | OTHER
  dataFlow        String?  // "BP number, contract data"
  dataFlowBack    String?  // "Contract account number"

  // Manual validation fields (consultores preenchem)
  integrationType String   @default("OTHER") // BAPI | IDOC | FILE | API | BATCH | OTHER
  trigger         String   @default("")
  timing          String   @default("SYNC") // SYNC | ASYNC | BATCH | EVENT
  ownerUserId     String?  // Consultor responsável pela integração
  status          String   @default("PENDING") // OK | PENDING | CONFLICT | CIRCULAR
  manualNotes     String?

  // Relations
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromReq         Requirement @relation("FromRequirement", fields: [fromReqId], references: [id])
  toReq           Requirement @relation("ToRequirement", fields: [toReqId], references: [id])
  owner           User?    @relation("IntegrationOwner", fields: [ownerUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, fromReqId, toReqId])
  @@map("cross_matrix_entries")
}

model ChangeLog {
  id              String   @id @default(cuid())
  requirementId   String
  userId          String
  field           String   // Campo alterado
  oldValue        String?
  newValue        String?
  changeType      String   @default("UPDATE") // CREATE | UPDATE | DELETE | STATUS_CHANGE | COMMENT_ADDED

  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())

  @@map("change_logs")
}

model Sprint {
  id              String   @id @default(cuid())
  projectId       String
  sprintNumber    Int
  startDate       DateTime
  endDate         DateTime
  goals           String
  retrospective   String?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, sprintNumber])
  @@map("sprints")
}

// Objetivos de negócio do projeto (Ancora Method v2)
// Usado para validação automática do WHY - requisitos órfãos são sinalizados
model ProjectObjective {
  id          String   @id @default(cuid())
  projectId   String

  // Identificador curto (ex: OBJ-001, META-01)
  code        String

  // Título do objetivo (ex: "Reduzir tempo de faturamento")
  title       String

  // Descrição detalhada do objetivo de negócio
  description String?

  // Fase SAP Activate relacionada (opcional)
  // DISCOVER | EXPLORE | REALIZE | DEPLOY | RUN
  activatePhase String?

  // Keywords para matching com campo WHY dos requisitos
  // JSON array: ["faturamento", "billing", "conta", "invoice"]
  keywords    String   @default("[]")

  // Prioridade para ordenação (1 = mais alta)
  priority    Int      @default(0)

  isActive    Boolean  @default(true)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId])
  @@map("project_objectives")
}

// Listas configuráveis por projeto (Módulos, Status, etc.)
// Substitui os enums hardcoded por valores dinâmicos no banco
model ProjectListItem {
  id          String   @id @default(cuid())
  projectId   String
  listType    String   // MODULE | REQ_STATUS | INTEGRATION_TYPE | INTEGRATION_TIMING
  code        String   // Código interno: ISU, PENDING, BAPI, SYNC
  name        String   // Nome legível: "ISU - Industry Solution Utilities"
  color       String?  // Cor hex para badges: #3B82F6
  icon        String?  // Emoji ou ícone: ⏳, ✅
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // Valor padrão ao criar requisito

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, listType, code])
  @@index([projectId, listType])
  @@map("project_list_items")
}

// ===== APPLICATION CONFIGURATION =====
// Configurações de aplicação em banco de dados (runtime)
// Infraestrutura (DATABASE_URL, JWT_SECRET, PORT) permanece em .env

model AppConfig {
  id          String   @id @default(cuid())

  // Chave de configuração em notação de ponto
  // Ex: "features.allowSeed", "ui.bannerMessage", "limits.maxUploadSize"
  key         String   @unique

  // Valor armazenado como JSON string (suporta todos os tipos)
  value       String

  // Tipo explícito para validação e renderização na UI
  // STRING | NUMBER | BOOLEAN | JSON | ENUM
  valueType   String   @default("STRING")

  // Categoria para agrupamento na UI de admin
  // FEATURE | UI | LIMIT | NOTIFICATION | INTEGRATION
  category    String   @default("FEATURE")

  // Descrição legível para UI de admin
  description String?

  // Ambiente específico (null = global, aplica a todos)
  // "production" | "staging" | "development" | "demo"
  environment String?

  // Regras de validação como JSON (min, max, pattern, enumValues)
  validation  String?

  // Soft delete para auditoria
  isActive    Boolean  @default(true)

  // Campos de auditoria
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([category])
  @@index([environment])
  @@map("app_configs")
}

// Histórico de alterações de configuração (audit trail)
model ConfigChangeLog {
  id          String   @id @default(cuid())
  configId    String
  configKey   String   // Desnormalizado para referência histórica

  oldValue    String?
  newValue    String?

  userId      String
  userName    String   // Desnormalizado
  userEmail   String   // Desnormalizado

  reason      String?  // Motivo opcional da alteração

  createdAt   DateTime @default(now())

  @@index([configId])
  @@index([userId])
  @@index([createdAt])
  @@map("config_change_logs")
}

// ===== MULTI-TENANCY MODELS =====
// Modelos para suporte a multi-tenant (database-per-client)
// Ver: docs/INFRASTRUCTURE_GUIDE.md seção 3.4
//
// TODO [ESTIGMERGIA]: Tenant Registry
// - Estes modelos existem aqui para desenvolvimento inicial
// - Em produção, o tenant registry será um banco Neon separado (ancoro-prod-tenant-registry)
// - O schema será idêntico, mas isolado dos dados de tenant
// - Migrar para schema separado quando implementar CI/CD de produção

model Tenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique  // URL-safe identifier: "seidor", "energia-vitalis"
  name                  String            // Nome legível: "Seidor Brasil"
  databaseUrlEncrypted  String   @map("database_url_encrypted")  // AES-256-GCM encrypted

  // Plano e status
  plan                  String   @default("pilot")   // pilot | starter | pro | enterprise
  status                String   @default("active")  // active | suspended | cancelled

  // Metadata
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users                 TenantUser[]

  @@map("tenants")
}

model TenantUser {
  tenantId   String
  userEmail  String      // Email do usuário (lookup key)
  role       String      // admin | member | readonly

  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, userEmail])
  @@index([userEmail])
  @@map("tenant_users")
}

// ===== ENUMS (Definidos como constantes TypeScript no código) =====
// SQLite não suporta enums nativamente, então usamos String
// Ao migrar para PostgreSQL, converter para enums nativos

// ProjectStatus: DISCOVERY | REALIZATION | GOLIVE | HYPERCARE | CLOSED
// UserRole: CONSULTANT | CLIENT | MANAGER | ADMIN
// SAPModule: ISU | CRM | FICA | DEVICE | SD | MM | PM | OTHER
// ReqStatus: PENDING | IN_PROGRESS | VALIDATED | CONFLICT | REJECTED | APPROVED
// CommentType: QUESTION | ANSWER | OBSERVATION | CONFLICT
// IntegrationType: BAPI | IDOC | FILE | API | BATCH | OTHER
// IntegrationTiming: SYNC | ASYNC | BATCH | EVENT
// IntegrationStatus: OK | PENDING | CONFLICT | CIRCULAR
// ChangeType: CREATE | UPDATE | DELETE | STATUS_CHANGE | COMMENT_ADDED
