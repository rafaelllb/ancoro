{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "types": ["node"]
  },
  "include": ["src", "test"]
}
